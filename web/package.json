{
  "name": "microrhododb-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MicroRhodoDB website 2.0 (dataset v1.6.0). Static React + TypeScript + Vite app served from /MicroRhodoDB/site/.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "echarts": "5.6.0",
    "molstar": "5.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "web-vitals": "6.2.3"
  }
}
